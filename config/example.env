# UyirPath configuration example
#
# The application has no secrets and no external service keys.
# This file documents the supported environment variables and CLI options.
# Copy values into your shell; the file is not read automatically.

# SQLite database file (default: data/uyirpath.db)
UYIRPATH_DB=data/uyirpath.db

# HTTP port (default 8080). Prefer the CLI flag: --port 8080
UYIRPATH_PORT=8080
